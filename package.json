{
  "name": "bevy-script-squadron-runtime",
  "version": "1.0.0",
  "description": "**Bevy Runeweave 是一个将多种脚本语言编织进 Bevy ECS 世界的游戏框架。**",
  "homepage": "https://github.com/Super1Windcloud/bevy-script-squadron-runtime#readme",
  "bugs": {
    "url": "https://github.com/Super1Windcloud/bevy-script-squadron-runtime/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Super1Windcloud/bevy-script-squadron-runtime.git"
  },
  "license": "GPL",
  "author": "Superwindcloud",
  "type": "module",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "package:windows": "tsx scripts/package-desktop.ts windows --release",
    "package:macos": "tsx scripts/package-desktop.ts macos --release",
    "release:assets": "tsx --env-file=.env scripts/publish-release.ts",
    "typecheck:scripts": "tsc --project scripts/tsconfig.json",
    "test": "npm run typecheck:scripts"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "tsx": "^4.20.6",
    "typescript": "7.0.2"
  }
}
