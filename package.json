{
  "name": "bevy-script-squadron-runtime",
  "version": "1.0.0",
  "description": "**Bevy Runeweave 是一个将多种脚本语言编织进 Bevy ECS 世界的游戏框架。**",
  "homepage": "https://github.com/Super1Windcloud/bevy-script-squadron-runtime#readme",
  "bugs": {
    "url": "https://github.com/Super1Windcloud/bevy-script-squadron-runtime/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Super1Windcloud/bevy-script-squadron-runtime.git"
  },
  "license": "GPL",
  "author": "Superwindcloud",
  "type": "module",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "package:windows": "tsx scripts/package-desktop.ts windows --release",
    "package:macos": "tsx scripts/package-desktop.ts macos --release",
    "package:android": "tsx scripts/package-android.ts",
    "create:game": "tsx scripts/create-game-project.ts",
    "release:assets": "tsx --env-file=.env scripts/publish-release.ts",
    "update:bevy": "tsx scripts/update-bevy-runtime.ts",
    "typecheck:scripts": "tsc --project scripts/tsconfig.json",
    "prepare:host-locales": "tsx scripts/prepare-host-locales.ts",
    "test:host-locales": "tsx --test scripts/host-localization.test.ts scripts/ios-device-selection.test.ts",
    "test:ios-download": "tsx --test scripts/ios-download.test.ts",
    "test:mobile-resources": "tsx --test scripts/mobile-resource-cleanup.test.ts",
    "test:release-assets": "tsx --test scripts/release-assets.test.ts",
    "test": "npm run typecheck:scripts && npm run test:release-assets && npm run test:host-locales"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "@types/node": "^26.1.2",
    "esbuild": "^0.28.1",
    "javascript-obfuscator": "^5.5.0",
    "luamin": "^1.0.4",
    "tsx": "^4.20.6",
    "typescript": "7.0.2"
  }
}
