    public static final class AppVersionRange {
        @SerializedName("min")
        private int min;

        @SerializedName("max")
        private int max;

        public int getMin() {
            return min;
        }

        public void setMin(int min) {
            this.min = min;
        }

        public int getMax() {
            return max;
        }

        public void setMax(int max) {
            this.max = max;
        }

        public boolean contains(int appVersion) {
            return min <= max && appVersion >= min && appVersion <= max;
        }
    }

