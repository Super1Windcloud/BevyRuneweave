    public boolean isPointsMallVersionHidden(int appVersion) {
        if (hidePointsMallAppVersionRanges == null) {
            return false;
        }
        for (AppVersionRange range : hidePointsMallAppVersionRanges) {
            if (range != null && range.contains(appVersion)) {
                return true;
            }
        }
        return false;
    }

    public boolean isPointsMallEnabled(int appVersion, String flavorUrl) {
        return isPointsMallUrlEnabled(flavorUrl) && !isPointsMallVersionHidden(appVersion);
    }

    public List<AppVersionRange> getHidePointsMallAppVersionRanges() {
