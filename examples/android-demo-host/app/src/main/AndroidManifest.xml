<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="Bevy RuneWeave"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">
        <activity
            android:name=".MainActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".RuntimeActivity"
            android:configChanges="orientation|keyboard|keyboardHidden|screenSize|smallestScreenSize|screenLayout|density|fontScale|layoutDirection|locale|uiMode"
            android:enableOnBackInvokedCallback="true"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="fullUser"
            android:theme="@style/RuntimeTheme">
            <meta-data
                android:name="android.app.lib_name"
                android:value="bevy_runeweave" />
        </activity>
    </application>
</manifest>
